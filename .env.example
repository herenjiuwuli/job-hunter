# 后端端口
PORT=3100

# DeepSeek（M2 AI 定制 / M3 匹配打分时使用；M1 不需要）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# token 签名密钥（部署到公网时建议显式设置：换机器/重建容器不会把所有人踢下线）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 不设也能跑 —— 会自动生成并写到 server/data/.jwt-secret（该目录已 gitignore）
JWT_SECRET=
