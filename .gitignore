node_modules/
dist/
.env
*.local

# 运行时数据（简历 / 投递记录 / 面试记录 / 候选人画像等个人敏感数据，不提交）
# 用目录级忽略，只放行岗位知识库 jobs.json（非敏感，需进 git）——
# 白名单式逐个列文件名会漏（曾漏掉 profile.json，候选人画像含薪资等敏感字段）
server/data/*
!server/data/jobs.json

# 数据目录的手工/迁移备份（含同样的个人敏感数据，绝不能进 git）
server/data.bak-*/
data.bak-*/

# 个人 JD 语料库（data/jd/jobs.json：我在跟/排除的岗位、薪资、排除原因）
# 属求职隐私，不进公开仓库。要纳管就删掉这一行并 git add 强制添加。
data/jd/

# Python 测试栈（pytest）
.venv/
.pytest_cache/
__pycache__/
