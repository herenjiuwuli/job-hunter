{
  "name": "job-hunter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-clean.mjs",
    "dev:raw": "concurrently -n fe,be -c blue,green \"vite\" \"node server/dev.js\"",
    "dev:fe": "vite",
    "dev:be": "node server/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/start.js",
    "test:ledger": "node scripts/test-applied-ledger.mjs",
    "test:jobid": "node scripts/test-jobid.mjs",
    "test:lines": "node scripts/test-batch-lines.mjs",
    "test:quota": "node scripts/test-quota.mjs",
    "test:store": "node scripts/test-store.mjs",
    "test:invites": "node scripts/test-invites.mjs",
    "test:collector": "node scripts/test-collector.mjs",
    "test:filters": "node scripts/test-filters.mjs",
    "test:ext": "node scripts/test-applied-ledger.mjs && node scripts/test-jobid.mjs && node scripts/test-batch-lines.mjs && node scripts/test-quota.mjs",
    "test:node": "node scripts/test-store.mjs && node scripts/test-invites.mjs && node scripts/test-applied-ledger.mjs && node scripts/test-jobid.mjs && node scripts/test-batch-lines.mjs && node scripts/test-quota.mjs && node scripts/test-stage.mjs && node scripts/test-collector.mjs && node scripts/test-filters.mjs",
    "jd:stats": "node scripts/jd-stats.mjs",
    "migrate:owner": "node scripts/migrate-owner.mjs",
    "user:create": "node scripts/create-user.mjs",
    "check:ui:login": "node scripts/verify-login-flow.mjs",
    "check:frontend": "node scripts/check-vue-undef.mjs src && node scripts/check-vue-tpl.mjs src && node scripts/check-vue-refvalue.mjs src/views",
    "check:frontend:undef": "node scripts/check-vue-undef.mjs src",
    "check:frontend:tpl": "node scripts/check-vue-tpl.mjs src",
    "check:frontend:refvalue": "node scripts/check-vue-refvalue.mjs src/views",
    "migrate:stages": "node scripts/migrate-stages.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "mammoth": "^1.13.0",
    "unpdf": "^1.9.1",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.4",
    "vite": "^8.2.0"
  }
}
